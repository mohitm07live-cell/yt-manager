# ========================================================
# YouTube Management Bot - Environment Variables Template
# Copy and set these in your Render Dashboard: Environment
# ========================================================

# Web Service Port (Render sets this automatically to 10000)
PORT=10000
NODE_ENV=production

# Google Cloud OAuth 2.0 Credentials
# Get these from Google Cloud Console > APIs & Services > Credentials
CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret_here

# OAuth Redirect URI
# Set this to your Render service URL + /auth/google/callback
# Example: https://yt-management-bot-xxxx.onrender.com/auth/google/callback
REDIRECT_URI=https://your-service-name.onrender.com/auth/google/callback

# Session Secret (Can be any random string)
SESSION_SECRET=render_yt_bot_session_secret_2025

# Gemini AI API Key (Optional, for AI Chat Responder & SEO tools)
GEMINI_API_KEY=your_gemini_api_key_here
